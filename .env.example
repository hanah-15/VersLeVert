# Django
SECRET_KEY=change-me
DEBUG=True

# PostgreSQL
DB_NAME=verslevert
DB_USER=verslevert
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433

# Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini (places, events and waste) - obtain your key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# Events use their own model and timeout independently of waste/proofs.
EVENTS_GEMINI_MODEL=gemini-3.5-flash-lite
EVENTS_GEMINI_TIMEOUT_SECONDS=20

# Places guide: independent, structured query understanding
PLACES_GEMINI_MODEL=gemini-3.5-flash-lite
PLACES_GEMINI_TIMEOUT_SECONDS=15

# Place neighbourhood labels (single-click lookup, cached and rate limited)
PLACES_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
PLACES_GEOCODER_USER_AGENT=VersLeVert/1.0 (+https://github.com/hanah-15/VersLeVert)

# Groq (challenges)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_TOKENS=500

# OCR / eco proofs
PROOF_OCR_PROVIDERS=gemini,ocrspace
PROOF_AI_MODEL=gemini-3.5-flash-lite
OCRSPACE_API_KEY=
PROOF_AI_TIMEOUT_SECONDS=12
PROOF_AI_MAX_RETRIES=0
PROOF_AI_MAX_RPM=8
PROOF_AI_DAILY_BUDGET=200
PROOF_AI_USER_DAILY_LIMIT=50
PROOF_TASK_BACKEND=thread
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
PROOF_MAX_UPLOAD_MB=5
PROOF_MAX_PIXELS=25000000
PROOF_MAX_PDF_PAGES=3
PROOF_AUTO_APPROVE_THRESHOLD=0.50
PROOF_MAX_POINTS_PER_MONTH=400
PROOF_CAP_MULTIPLIER=10
PROOF_WINDOW_OVERRIDE_DAYS=
PROOF_UPLOADS_PER_HOUR=10
PROOF_OCR_TIMEOUT_SECONDS=25
PROOF_PHASH_MAX_DISTANCE=5
PROOF_MIN_SHORT_SIDE_PX=700
PROOF_BLUR_MIN_LAPLACIAN_VAR=60
PROOF_STORAGE_BACKEND=local
PROOF_CLOUDINARY_FOLDER=vers-le-vert/proofs
PROOF_STORAGE_TIMEOUT_SECONDS=20
PROOF_UPLOAD_RETRIES=2
PROOF_REJECTED_RETENTION_DAYS=90
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe


# Optional Cloudinary image storage; leave blank to use local media
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public images: auto selects Cloudinary when configured; local keeps existing files.
PUBLIC_MEDIA_BACKEND=auto
